// Локальная база данных проекта — всё хранится в одном файле SQLite.
// Путь к файлу задаётся через DATABASE_URL (по умолчанию ./prisma/dev.db,
// на сервере указывает на постоянный диск, напр. file:/data/app.db).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float
  description String?
  category    String?
  sizes       String   @default("[]") // JSON-массив строк: ["S","M","L"]
  images      String   @default("[]") // JSON-массив путей: ["/uploads/ab.jpg"]
  composition String?  // Состав
  care        String?  // Уход
  sizeChart   String   @default("[]") // JSON: [{size,bust,waist,hips}]
  isNew       Boolean  @default(false)
  isOnSale    Boolean  @default(false)
  oldPrice    Float?
  isAvailable Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([isAvailable, order])
  @@index([category])
}

model Page {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String @default("") // HTML-содержимое страницы
}

model SiteSettings {
  id             String  @id @default("singleton")
  logo           String?
  heroImage      String?
  heroTitle      String?
  heroSubtitle   String?
  heroQuote      String?
  telegramBotUrl String?
  instagramUrl   String?
  phone          String?
  email          String?
  address        String?

  // Тумблеры функций (управляются из админки /admin/settings)
  cartEnabled          Boolean @default(false) // корзина выключена по умолчанию
  telegramOrderEnabled Boolean @default(true)  // кнопка заказа через Telegram
  telegramButtonText   String? // текст кнопки Telegram (по умолч. «Заказать пошив в Telegram»)
  onlinePaymentEnabled Boolean @default(false) // онлайн-оплата картой (Т-Банк)

  // Реквизиты ИП (для контактов, подвала, оферты/политики)
  ipName    String? // «ИП Иванова Ксения Сергеевна»
  ipInn     String? // ИНН
  ipOgrnip  String? // ОГРНИП
  ipAddress String? // юридический адрес
}

// Заказы из корзины. items — JSON-массив позиций (см. OrderItem в types.ts).
model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  phone     String
  address   String?
  comment   String?
  items     String   @default("[]") // JSON: [{productId,name,size,qty,price}]
  total     Float    @default(0)
  status    String   @default("new") // new | processing | done | cancelled

  // Онлайн-оплата (Т-Банк)
  paymentId     String?   // PaymentId от Т-Банка
  paymentStatus String    @default("none") // none | pending | paid | rejected | refunded
  paidAt        DateTime?

  @@index([status, createdAt])
}
